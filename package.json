{
  "name": "@forq/sdk",
  "version": "1.0.0",
  "description": "TypeScript SDK for Forq",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "keywords": [
    "queue",
    "message-queue",
    "sqlite",
    "forq",
    "typescript",
    "indie-dev",
    "bootstrap",
    "background-jobs"
  ],
  "author": "Myko Nordy",
  "license": "Apache-2.0",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "eslint": "^10.8.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
